# Copy to .env.local for local development. None of these are required to run
# the site — the gift request form gracefully no-ops (logs instead of sends)
# when RESEND_API_KEY is unset.

# Resend API key for sending gift-request emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that gift requests are delivered to (the owner).
REQUEST_FORM_TO=hello@latteblooms.com

# Optional: verified Resend sender. Defaults to onboarding@resend.dev (testing).
# Switch to an address on your verified domain once DNS is set up. Customer
# confirmation emails are only sent when this is a verified-domain address.
# REQUEST_FORM_FROM="Latte Blooms <hello@latteblooms.com>"
